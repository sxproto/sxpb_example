; Edge cases intended to exercise implementation conformance.
; These examples are valid SxPB, even when their shapes are unusual.

; Dict bodies can contain arbitrary fields, including loneof fields.
(my_dict ()
 ((my_key my_loneof_array_option) (()) 1 2 3)
 ((my_message_key my_loneof_message_option) (nested value))
 ((my_dict_key my_loneof_dict_option) () (a 1) (b 2))
)

; Manyof variant 2 can mix literal entries and nested any_field entries.
((expr)
 1
 2
 (add (()) (value 3) (value 4))
 ((mul) 5 6)
)

; Empty containers in every field-body spelling.
(empty_message)
(empty_array (()))
(empty_dict ())
(empty_manyof (()))
(empty_loneof_array_option ((choice array) (())))

; Numeric-looking and boolean-looking strings must remain strings when quoted.
(string_atoms (()) "1" "+true" "+false" "1.5" bare)

; Anonymous strings and anonymous nests in nest content.
(my_nest ("")
 ("" multi word leaf)
 (anonymous ("") content)
 (empty_child)
)
